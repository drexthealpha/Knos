    {"name": "Team, 2 million accepted a month: the second million pays 0.20%", "in": {"plan": "team", "evaluations": 250000, "accepted": "24000000.00", "on_chain_percent": 0, "lookups": 0}, "how": "Meter 150,000 x 0.002 x 12 = 3,600. Acceptance a month: 1,000,000 x 0.30% + 1,000,000 x 0.20% = 5,000; twelve months, 60,000. 25,000 + 3,600 + 60,000 = 88,600.", "out": {"control": "25,000.00", "meter": "3,600.00", "acceptance": "60,000.00", "paid_on_chain": "0.00", "rebate": "0.00", "records": "0.00", "total": "88,600.00", "benefit_to_demand": "265,800.00"}},
