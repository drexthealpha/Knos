<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="knos-iris.ZPM">
    <Module>
      <Name>knos-iris</Name>
      <Version>0.1.12</Version>
      <Description>An IRIS Interoperability production where an AI Hub agent decides if a lab's locked test criteria are met, and only then a payout step runs.</Description>
      <Keywords>interoperability ai-hub fhir workflow pex vector</Keywords>
      <Packaging>module</Packaging>
      <SystemRequirements Version=">=2026.3" Interoperability="enabled"/>
      <SourcesRoot>src</SourcesRoot>
      <Resource Name="Knos.Iris.PKG"/>
      <!-- Python: the Knos modules IRIS imports (python/knos/, copied from src/knos: python/VENDORED.txt) and knos_iris
           straight into mgr/python, where every IRIS process imports them; nothing comes from outside iris/ -->
      <!-- Overlay: add the files, never delete what is already in the folder (IPM's default replaces it whole) -->
      <FileCopy Name="python/knos/" Target="${mgrdir}python/knos/" Overlay="1"/>
      <FileCopy Name="python/knos_iris/" Target="${mgrdir}python/knos_iris/" Overlay="1"/>
      <!-- the folder Knos.Iris.Util.Home() reads when KNOS_IRIS_HOME is not set: <install>/knos -->
      <FileCopy Name="fixtures/" Target="${mgrdir}../knos/iris/fixtures/"/>
      <FileCopy Name="java/" Target="${mgrdir}../knos/iris/java/"/>
      <FileCopy Name="merge.cpf" Target="${mgrdir}../knos/iris/merge.cpf"/>
      <!-- KNOS_FHIR=0: no FHIR server; Setup compiles the Java PEX jar with the instance's own JDK, then starts the production -->
      <Invoke Class="Knos.Iris.Setup" Method="Install">
        <Arg>0</Arg>
      </Invoke>
    </Module>
  </Document>
</Export>
