    <Module>
      <Name>knos-iris</Name>
      <Version>0.1.0</Version>
      <Description>Knos Referee on IRIS: proof against a hash-locked Knos Ready brief, decided by an AI Hub agent that can only say no or ask a person.</Description>
      <Keywords>interoperability ai-hub fhir workflow pex vector</Keywords>
      <Packaging>module</Packaging>
      <SourcesRoot>src</SourcesRoot>
      <Resource Name="Knos.Iris.PKG"/>
