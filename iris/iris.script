zn "%SYS"
do ##class(Security.Users).UnExpireUserPasswords("*")
zn "HSLIB"
; the KNOS namespace, unless iris/scripts/namespace.script made it already (iris/Dockerfile runs that as its own cached step)
if '##class(%SYS.Namespace).Exists("KNOS") { set sc = ##class(HS.Util.Installer.Foundation).Install("KNOS") if 'sc { do $system.Status.DisplayError(sc) } }
zn "KNOS"
set sc = $system.OBJ.LoadDir("/home/irisowner/knos/iris/src", "ck", .err, 1)
if 'sc { do $system.Status.DisplayError(sc) }
set sc = ##class(Knos.Iris.Setup).Install(+$system.Util.GetEnviron("KNOS_FHIR"))
if 'sc { do $system.Status.DisplayError(sc) }
; stopped cleanly here, so the container's start auto-starts it (a running stop left a runtime lock: 16 min, then ErrCanNotAcquireRuntimeLock)
set sc = ##class(Ens.Director).StopProduction(60, 1)
if 'sc { do $system.Status.DisplayError(sc) }
halt
