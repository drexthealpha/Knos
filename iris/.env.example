# cp .env.example .env   (never commit .env); then fill the three values below, for example with: openssl rand -hex 16
# the password of _SYSTEM, SuperUser and Admin, set at every start (the image's SYS is refused)
IRIS_PASSWORD=
# GitHub's webhook secret: a check run is proof only with its X-Hub-Signature-256 under this secret
KNOS_WEBHOOK_SECRET=
# the referee's secret: a verdict is read only when its "signature" is the HMAC-SHA256 of its body under this secret
KNOS_VERDICT_SECRET=
# live: the AI Hub agent asks this provider; replay: recorded answers, no key needed
KNOS_AI_MODE=replay
KNOS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
KNOS_SOLANA_RPC=https://api.devnet.solana.com
# optional: a devnet keypair file mounted into the container, for live funding and relaying
KNOS_DEVNET_KEYPAIR=
# optional: polling GitHub check runs
GITHUB_TOKEN=
KNOS_PAYOUT_THRESHOLD_USDC=50
# optional: the Management Portal's base URL in Visual Trace links (a gateway or host in front of IRIS); empty: the request's own host
KNOS_IRIS_PORTAL=
