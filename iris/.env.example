# cp .env.example .env   (never commit .env)
# live: the AI Hub agent asks this provider; replay: recorded answers, no key needed
KNOS_AI_MODE=replay
KNOS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
KNOS_SOLANA_RPC=https://api.devnet.solana.com
# optional: a devnet keypair file mounted into the container, for live funding and relaying
KNOS_DEVNET_KEYPAIR=
# optional: polling GitHub check runs
GITHUB_TOKEN=
KNOS_PAYOUT_THRESHOLD_USDC=50
