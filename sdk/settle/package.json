  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "solana",
    "oidc",
    "github-actions",
    "pay-on-proof",
    "knos",
    "x402",
    "payments"
  ],
  "license": "MIT",
  "homepage": "https://github.com/drexthealpha/Knos/tree/main/sdk/settle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drexthealpha/Knos.git",
    "directory": "sdk/settle"
  },
  "bugs": {
    "url": "https://github.com/drexthealpha/Knos/issues"
  },
  "sideEffects": false,
