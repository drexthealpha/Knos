{
  "name": "knos-settle",
  "version": "0.4.1",
  "description": "Knos carries research across the valley of death.",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./agent": {
      "types": "./agent.d.ts",
      "default": "./agent.js"
    },
    "./passkey": {
      "types": "./passkey.d.ts",
      "default": "./passkey.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "agent.js",
    "agent.d.ts",
    "passkey.js",
    "passkey.d.ts",
    "README.md"
  ],
