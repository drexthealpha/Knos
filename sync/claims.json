 "existing": [
  {
   "name": "claims_check",
   "command": "python scripts/claims_check.py",
   "run_by": ".github/workflows/tests.yml job claims; tests/test_bench_docs.py (--offline)",
   "checks": "every number in README.md, web/door.html and docs/WHY.md is a fact in docs/facts.json, and every fact holds against its source; a fact with doc makes that document say its numbers",
   "files": [
    "README.md",
    "web/door.html",
    "docs/WHY.md"
   ],
   "facts_from": "docs/facts.json"
  },
  {
   "name": "doc_claims",
   "command": "python scripts/doc_claims.py",
   "run_by": ".github/workflows/tests.yml job claims; tests/test_doc_claims.py",
   "checks": "facts several documents state (capability counts and stages, program versions, upgrade times, fees, payment totals, slots), each from one source"
  },
  {
   "name": "bench_docs",
   "command": "python scripts/bench_docs.py --check",
   "run_by": "tests/test_bench_docs.py",
   "checks": "the [[stat: name]] slots and the bench tables equal docs/bench.json and docs/facts.json by_hand"
  },
  {
   "name": "capabilities",
   "command": "python scripts/capabilities.py render --check",
   "run_by": "scripts/capabilities.py",
   "checks": "the capability tables between their markers are what docs/capabilities.json says"
  },
  {
   "name": "rate_claims",
   "command": "python scripts/rate_claims.py",
   "run_by": ".github/workflows/tests.yml job claims; tests/test_rate_claims.py",
   "checks": "every latency or throughput figure in docs/reference/LOAD.md and BENCH.md carries its sample size, program ids and date"
  },
  {
   "name": "test_public_words",
   "command": "python scripts/test_public_words.py",
   "run_by": ".github/workflows/tests.yml job conformance",
   "checks": "public words: no escrow, the 8-day time lock, no private or Windows user folder, the pricing sentence, two links"
  },
  {
   "name": "truth_check",
   "command": "python scripts/truth_check.py",
   "run_by": ".github/workflows/tests.yml job claims",
   "checks": "no public statement contradicts the capability manifest, the source or the price book"
  },
  {
   "name": "stale_check",
   "command": "python scripts/stale_check.py",
   "run_by": ".github/workflows/tests.yml job claims",
   "checks": "no public file states a retired figure as current"
  },
  {
   "name": "site_pages",
   "command": "bash scripts/build_site.sh",
   "run_by": ".github/workflows/network.yml (the site's build)",
   "checks": "writes the pricing numbers (span data-n) and the company sentence into the built pages from docs/data at build time"
  }
 ],
