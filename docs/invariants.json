          }
        ]
      },
      {
        "case": "late: the record saw an order after the period closed",
        "record": "carried to the next period, never added; a line that bills it is held",
        "tests": [
          {
            "file": "tests/test_completeness.py",
            "test": "test_an_order_seen_after_the_period_closed_is_carried_never_added_and_a_line_that_bills_it_is_held"
          }
        ]
      },
      {
        "case": "duplicated: one deliverable under two ids (two lines, or two orders)",
        "record": "counted once; the others flagged and left out of the count",
        "tests": [
          {
            "file": "tests/test_completeness.py",
            "test": "test_one_deliverable_under_two_ids_is_counted_once_and_flagged"
          }
        ]
      },
      {
        "case": "a retried webhook: the same event delivered again",
        "record": "the same arrival changes nothing; the same event from a second source is a repeat, counted once; the same id with another amount is refused",
        "tests": [
          {
            "file": "tests/test_completeness.py",
            "test": "test_a_retried_webhook_is_one_event_and_the_same_event_from_a_second_source_is_counted_once"
          }
        ]
      },
      {
        "case": "a delayed bank status: unknown, then paid; or paid twice",
