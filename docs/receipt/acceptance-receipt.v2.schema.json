{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/drexthealpha/Knos/blob/main/docs/receipt/acceptance-receipt.v2.schema.json",
 "title": "Knos acceptance receipt, version 2",
 "description": "Four separate things, in this order: what the issuer authenticated, what the evaluator observed, which policy produced the verdict, what trust remains; then the order's amendments and the payment. The rules a schema cannot say are in docs/RECEIPT.md.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "amendments",
  "amounts",
  "cluster",
  "evaluator_observed",
  "issuer_authenticated",
  "order",
  "payees",
  "policy",
  "program",
  "repository",
  "scope",
  "transaction",
  "trust_remaining",
  "type",
  "version"
 ],
 "properties": {
  "type": {
   "const": "knos.acceptance-receipt"
  },
  "version": {
   "const": 2
  },
  "cluster": {
   "enum": [
    "devnet",
    "mainnet-beta",
    "localnet"
   ]
  },
  "program": {
   "type": "string",
   "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
  },
  "order": {
   "type": "string",
   "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
  },
  "scope": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "repository": {
   "oneOf": [
    {
     "type": "null"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "id",
      "issue"
     ],
     "properties": {
      "id": {
       "type": "integer",
       "minimum": 1
      },
      "issue": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   ]
  },
  "issuer_authenticated": {
   "description": "1. What the issuer authenticated: the host signed which workflow file at which commit ran in which repository for which event, and when; knos_oidc verified that signature on chain in `verified.transaction`.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "claims",
    "issuer",
    "provider",
    "token_sha256",
    "verified"
   ],
   "properties": {
    "provider": {
     "enum": [
      "github",
      "gitlab"
     ]
    },
    "issuer": {
     "type": "string",
     "pattern": "^https://"
    },
    "claims": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "actor_id",
        "event_name",
        "exp",
        "iat",
        "job_workflow_ref",
        "job_workflow_sha",
        "repository_id",
        "repository_owner_id",
        "run_attempt",
        "run_id",
        "runner_environment"
       ],
       "properties": {
        "actor_id": {
         "type": "string"
        },
        "event_name": {
         "type": "string"
        },
        "exp": {
         "type": "integer",
         "minimum": 0
        },
        "iat": {
         "type": "integer",
         "minimum": 0
        },
        "job_workflow_ref": {
         "type": "string"
        },
        "job_workflow_sha": {
         "type": "string",
         "pattern": "^[0-9a-f]{40}$"
        },
        "repository_id": {
         "type": "string"
        },
        "repository_owner_id": {
         "type": "string"
        },
        "run_attempt": {
         "const": "1"
        },
        "run_id": {
         "type": "string"
        },
        "runner_environment": {
         "const": "github-hosted"
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "ci_config_ref_uri",
        "ci_config_sha",
        "exp",
        "iat",
        "namespace_id",
        "pipeline_id",
        "pipeline_source",
        "project_id",
        "project_path",
        "ref",
        "ref_path",
        "ref_protected",
        "ref_type",
        "runner_environment",
        "sha",
        "user_id"
       ],
       "properties": {
        "ci_config_ref_uri": {
         "type": "string"
        },
        "ci_config_sha": {
         "type": "string",
         "pattern": "^[0-9a-f]{40}$"
        },
        "exp": {
         "type": "integer",
         "minimum": 0
        },
        "iat": {
         "type": "integer",
         "minimum": 0
        },
        "namespace_id": {
         "type": "string",
         "pattern": "^[1-9][0-9]{0,16}$"
        },
        "pipeline_id": {
         "type": "string"
        },
        "pipeline_source": {
         "const": "pipeline"
        },
        "project_id": {
         "type": "string",
         "pattern": "^[1-9][0-9]{0,16}$"
        },
        "project_path": {
         "type": "string",
         "minLength": 1
        },
        "ref": {
         "type": "string"
        },
        "ref_path": {
         "type": "string",
         "minLength": 1
        },
        "ref_protected": {
         "const": "true"
        },
        "ref_type": {
         "const": "branch"
        },
        "runner_environment": {
         "const": "gitlab-hosted"
        },
        "sha": {
         "type": "string",
         "pattern": "^[0-9a-f]{40}$"
        },
        "user_id": {
         "type": "string",
         "pattern": "^[1-9][0-9]{0,16}$"
        }
       }
      }
     ]
    },
    "token_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "verified": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "key",
      "program",
      "transaction"
     ],
     "properties": {
      "program": {
       "type": "string",
       "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
      },
      "key": {
       "type": "string",
       "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
      },
      "transaction": {
       "type": "string",
       "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
      }
     }
    }
   }
  },
  "evaluator_observed": {
   "description": "2. What the evaluator observed: the pinned judge's verdict, the named checks and their conclusions, the accepted commit and pull request, and the judge's version (the commit of its workflow).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "artifact",
    "checks",
    "judge",
    "verdict"
   ],
   "properties": {
    "judge": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "version"
     ],
     "properties": {
      "kind": {
       "enum": [
        "repository",
        "neutral",
        "attestor",
        "arbiter"
       ]
      },
      "version": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      }
     }
    },
    "verdict": {
     "const": "accepted"
    },
    "checks": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "conclusion",
       "name"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "conclusion": {
        "const": "passed"
       }
      }
     }
    },
    "artifact": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "commit",
      "pull_request"
     ],
     "properties": {
      "commit": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      },
      "pull_request": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  },
  "policy": {
   "description": "3. Which policy produced the verdict: the hash of the terms fixed at funding, the mode, the allowed and denied paths and the terms' version (null when the terms are not public).",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "allowed_paths",
    "denied_paths",
    "mode",
    "terms_hash",
    "version"
   ],
   "properties": {
    "terms_hash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
     "enum": [
      "merge",
      "tests"
     ]
    },
    "allowed_paths": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "items": {
        "type": "string"
       },
       "uniqueItems": true
      }
     ]
    },
    "denied_paths": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "items": {
        "type": "string"
       },
       "uniqueItems": true
      }
     ]
    },
    "version": {
     "enum": [
      1,
      null
     ]
    }
   }
  },
  "trust_remaining": {
   "description": "4. What trust remains, in plain words: exactly the list knos.receipt.trust_of gives for this provider, mode and judge.",
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "string"
   }
  },
  "amendments": {
   "description": "Every change of the order's terms between its funding and this payment, oldest first, each with its transaction.",
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "detail",
     "kind",
     "time",
     "transaction"
    ],
    "properties": {
     "kind": {
      "enum": [
       "topup",
       "assign",
       "reserve",
       "cancel",
       "plan"
      ]
     },
     "transaction": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
     },
     "time": {
      "type": "integer",
      "minimum": 0
     },
     "detail": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    }
   }
  },
  "payees": {
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "amount",
     "bps",
     "github_id",
     "to"
    ],
    "properties": {
     "github_id": {
      "type": "integer",
      "minimum": 1
     },
     "bps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
     },
     "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
     },
     "to": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
     }
    }
   }
  },
  "amounts": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "decimals",
    "fee",
    "mint",
    "of",
    "paid",
    "tip"
   ],
   "properties": {
    "mint": {
     "type": "string",
     "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
    },
    "decimals": {
     "type": "integer",
     "minimum": 0,
     "maximum": 18
    },
    "paid": {
     "type": "string",
     "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "of": {
     "type": "string",
     "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "fee": {
     "type": "string",
     "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "tip": {
     "type": "string",
     "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
   }
  },
  "transaction": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "signature",
    "slot",
    "time"
   ],
   "properties": {
    "signature": {
     "type": "string",
     "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
    },
    "slot": {
     "type": "integer",
     "minimum": 0
    },
    "time": {
     "type": "integer",
     "minimum": 0
    }
   }
  }
 }
}
